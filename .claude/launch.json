{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "question-review",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8765",
        "--bind",
        "127.0.0.1",
        "--directory",
        "eval/questions"
      ],
      "port": 8765
    },
    {
      "name": "demo",
      "runtimeExecutable": "docker",
      "runtimeArgs": [
        "compose",
        "run",
        "--rm",
        "--name",
        "rag-demo-preview",
        "-p",
        "8003:8000",
        "-e",
        "DEMO_MODE=true",
        "-e",
        "EMBED_THREADS=1",
        "api",
        "uv",
        "run",
        "--frozen",
        "fastapi",
        "dev",
        "app/main.py",
        "--host",
        "0.0.0.0",
        "--port",
        "8000"
      ],
      "port": 8003
    }
  ]
}
