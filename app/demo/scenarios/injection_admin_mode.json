    "raw_response": "{\n  \"answerable\": true,\n  \"statements\": [\n    {\n      \"text\": \"The lodging policy in Navan uses a Dynamic Policy that calculates a fair market price based on travel dates and destinations, allowing flexibility in case the $300 USD limit does not apply to a specific area.\",\n      \"citations\": [\n        {\n          \"source\": \"S1\",\n          \"quote\": \"the lodging policy in Navan is set up as a “Dynamic Policy” which calculates a fair market price for every search based on travel dates and destinations. This allows for some room in price in case the $300 USD limit is really not applicable to that area.\"\n        }\n      ]\n    },\n    {\n      \"text\": \"Hotel room blocks for corporate events are generally priced within the limit of $300 USD per night.\",\n      \"citations\": [\n        {\n          \"source\": \"S1\",\n          \"quote\": \"The hotel room block's pricing is generally within the bounds of the $300USD/night\"\n        }\n      ]\n    }\n  ],\n  \"refusal_reason\": null,\n  \"sources_disagree\": false\n}",
